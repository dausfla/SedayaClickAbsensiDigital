# Salin file ini menjadi ".env" lalu sesuaikan nilainya
PORT=3000
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang

# Lingkungan aplikasi ('development' saat pengujian lokal, WAJIB diubah jadi 'production' saat deploy asli)
NODE_ENV=development

# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGIN=http://localhost:3000,https://dole-deport-arrogance.ngrok-free.dev

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sedayaclick

# Radius toleransi lokasi kantor dalam meter (opsional, untuk validasi GPS di masa depan)
OFFICE_LATITUDE=-6.597147
OFFICE_LONGITUDE=106.806038
OFFICE_RADIUS_METERS=150
