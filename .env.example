# Salin file ini menjadi ".env" lalu sesuaikan nilainya
PORT=3000
SESSION_SECRET=ganti_dengan_string_acak_yang_panjang

# Lingkungan aplikasi ('development' saat pengujian lokal, WAJIB diubah jadi 'production' saat deploy asli)
NODE_ENV=development

# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGIN=http://localhost:3000,https://dole-deport-arrogance.ngrok-free.dev

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sedayaclick

# Radius toleransi lokasi kantor dalam meter (opsional, untuk validasi GPS di masa depan)
OFFICE_LATITUDE=-6.597147
OFFICE_LONGITUDE=106.806038
OFFICE_RADIUS_METERS=150

# Web Push Notification VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sedayaclick.cloud

# SMTP Email Notification (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME="SedayaClick System"
EMAIL_FROM_ADDRESS=your_email@gmail.com
APP_BASE_URL=http://localhost:8080
FALLBACK_MANAGER_EMAIL=aditiafirdauss04@gmail.com,manager@gmail.com

# Telegram Ops & Maintenance Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=


